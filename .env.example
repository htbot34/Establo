# ──────────────────────────────────────────────────────────────────────────────
# Establo environment configuration
# Copy to .env and fill in what you have. EVERYTHING here is optional in
# RUN_MODE=mock — the app boots and works with zero external keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── Run mode ─────────────────────────────────────────────────────────────────
# mock       → no external services. Built-in WhatsApp simulator at /app/simulator.
#              Whisper/TTS stubbed. LLM/embeddings used IF keys present, else stubs.
# sandbox    → real Twilio WhatsApp sandbox + real Claude/OpenAI. Signature
#              validation ON (set TWILIO_VALIDATE_SIGNATURE=false to relax while
#              debugging ngrok).
# production → sandbox + enforced signature validation + template-only sends
#              outside the 24h window.
RUN_MODE=mock

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
# Public origin of THIS server (used to build Twilio media URLs + webhook URL).
# For sandbox local dev this is your ngrok URL, e.g. https://abc123.ngrok.app
PUBLIC_BASE_URL=http://localhost:8787
# Secret for signing session cookies. REQUIRED in sandbox/production.
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Where uploaded SOPs, generated audio, certificates and audit packs are stored.
DATA_DIR=./data/storage

# ── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults.
DATABASE_URL=postgres://establo:establo@localhost:5432/establo

# ── Anthropic (answer generation, OCR of photographed SOPs, module drafting) ─
# Optional in mock mode (falls back to a deterministic [STUB] answerer), but
# this is the expected dev setup: set it even in mock mode for real answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── OpenAI (embeddings, Whisper speech-to-text, TTS voice replies) ──────────
# Optional in mock mode: without it, retrieval uses a deterministic local
# hash-based pseudo-embedding (functional, not smart) and TTS produces a
# silent placeholder audio file.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# ── Twilio WhatsApp (sandbox/production only) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886. Production: your approved WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set false ONLY while debugging webhook URLs locally (sandbox).
TWILIO_VALIDATE_SIGNATURE=true

# ── Retrieval tuning ─────────────────────────────────────────────────────────
# Similarity floor below which Establo refuses instead of answering.
# Defaults: 0.25 with real embeddings, 0.02 with stub embeddings.
# RETRIEVAL_MIN_SIMILARITY=0.25
RETRIEVAL_TOP_K=6

# ── Jobs / scheduling ────────────────────────────────────────────────────────
# Cron for the drip scheduler tick (org-timezone-aware inside the job).
DRIP_CRON=*/15 * * * *
# true → run jobs inline instead of via pg-boss (used by tests).
JOBS_INLINE=false

# ── Billing (feature-flagged; OFF by default) ────────────────────────────────
ENABLE_BILLING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs: flat base fee + per-cow metered/quantity price
STRIPE_PRICE_BASE=
STRIPE_PRICE_PER_COW=
